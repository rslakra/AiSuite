# Server port (default 8080; macOS often reserves 5000 for AirPlay)
# PORT=8080

# Ollama models
# CHAT_MODEL=llama3:8b
# EMBED_MODEL=nomic-embed-text

# Runtime data root — uploads/ and chroma_store/ are created inside this folder.
# Relative paths are resolved from the Local-RAG-App project root.
APP_DATA_DIR=./app_data

# Comma-separated upload file extensions (with or without leading dots)
ALLOWED_EXTENSIONS=.pdf,.md,.txt

# RAG prompt template — use {context} and {question} placeholders.
# Leave unset to use the built-in default.
# RAG_PROMPT="Use only the context below to answer the question. If the answer isn't in the context, say you don't know.\n\nContext:\n{context}\n\nQuestion: {question}"
